module body Rambo.Pages is
    function destroyFrame(frame: Frame): Unit is
        let { title: String, error: String, info: String, back: String, card: Bool, nav: String, version: String,
            csrfLogout: String } := frame;
        destroyString(title);
        destroyString(error);
        destroyString(info);
        destroyString(back);
        destroyString(nav);
        destroyString(version);
        destroyString(csrfLogout);
        return nil;
    end;

    function destroyMessagePage(page: MessagePage): Unit is
        let { lang: String, frame: Frame } := page;
        destroyString(lang);
        destroyFrame(frame);
        return nil;
    end;

    generic [P: Region]
    function renderMessage(page: &[MessagePage, P]): String is
        var out: StringBuilder := makeStringBuilder();
        @template("templates/message.jinja", page, out);
        return finalize(out);
    end;

    generic [P: Region]
    function renderLogout(page: &[MessagePage, P]): String is
        var out: StringBuilder := makeStringBuilder();
        @template("templates/logout.jinja", page, out);
        return finalize(out);
    end;

    function destroyLoginPage(page: LoginPage): Unit is
        let { lang: String, frame: Frame, req: String, client: String, reauth: Bool, email: String, pow: String,
            powBits: Int64, powTimeout: Int64, powBatch: Int64, passkey: String, party: String } := page;
        destroyString(passkey);
        destroyString(party);
        destroyString(lang);
        destroyFrame(frame);
        destroyString(req);
        destroyString(client);
        destroyString(email);
        destroyString(pow);
        return nil;
    end;

    generic [P: Region]
    function renderLogin(page: &[LoginPage, P]): String is
        var out: StringBuilder := makeStringBuilder();
        @template("templates/login.jinja", page, out);
        return finalize(out);
    end;

    function destroyStepPage(page: StepPage): Unit is
        let { lang: String, frame: Frame, req: String, step: String, qr: String, secret: String } := page;
        destroyString(lang);
        destroyFrame(frame);
        destroyString(req);
        destroyString(step);
        destroyString(qr);
        destroyString(secret);
        return nil;
    end;

    generic [P: Region]
    function renderPassword(page: &[StepPage, P]): String is
        var out: StringBuilder := makeStringBuilder();
        @template("templates/password.jinja", page, out);
        return finalize(out);
    end;

    generic [P: Region]
    function renderTotp(page: &[StepPage, P]): String is
