The step after a one-time password: a password of one's own, twice.
-#}
{% extends "templates/layout.jinja" %}
{% block content %}
<p class="lead">{{ _("PasswordLead") }}</p>
<form method="post" action="/login/password">
<input type="hidden" name="req" value="{{ req }}">
<input type="hidden" name="step" value="{{ step }}">
<label>{{ _("PasswordNew") }} <small>{{ _("PasswordRule") }}</small>
<input type="password" name="password" autocomplete="new-password" minlength="12" maxlength="1024" required autofocus></label>
<label>{{ _("PasswordAgain") }}
<input type="password" name="password2" autocomplete="new-password" minlength="12" maxlength="1024" required></label>
<button type="submit">{{ _("PasswordSubmit") }}</button>
</form>
{% endblock %}
