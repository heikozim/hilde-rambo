The question before a logout: the form carries the token of the action
logout, and for a logout an app started the parameters it sent, so that
the logout it asked for ends where it asked.
-#}
{% extends "templates/layout.jinja" %}
{% block content %}
<p class="lead">{{ _("LogoutLead") }}</p>
<form method="post" action="/logout">
<input type="hidden" name="csrf" value="{{ frame.csrfLogout }}">
{% if clientId %}<input type="hidden" name="client_id" value="{{ clientId }}">
{% endif %}{% if idTokenHint %}<input type="hidden" name="id_token_hint" value="{{ idTokenHint }}">
{% endif %}{% if postLogout %}<input type="hidden" name="post_logout_redirect_uri" value="{{ postLogout }}">
{% endif %}{% if state %}<input type="hidden" name="state" value="{{ state }}">
{% endif %}
<button type="submit">{{ _("LogoutSubmit") }}</button>
</form>
<p><a href="/">{{ _("CommonCancel") }}</a></p>
{% endblock %}
