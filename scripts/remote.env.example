# Template for scripts/remote.env: the targets of the scripts that build
# or test on another machine (scripts/run.sh, tools/goconfig/run-remote.sh).
# Read by scripts/remote.sh; every variable of the environment wins over
# the file.  Copy it to scripts/remote.env and replace the values.
RAMBO_HOST=build.example.org
RAMBO_SSH_USER=builder
RAMBO_SSH_PORT=22
RAMBO_REMOTE_DIR=/srv/build/projects
RAMBO_BSD_HOST=bsd.example.org
RAMBO_BSD_TOOLCHAIN=/srv/build/projects/wolly/_toolchain
